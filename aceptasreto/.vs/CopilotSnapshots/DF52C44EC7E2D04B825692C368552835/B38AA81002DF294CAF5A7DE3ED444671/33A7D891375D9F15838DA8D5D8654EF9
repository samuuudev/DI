<Window x:Class="aceptasreto.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MainWindow" Height="720" Width="1250"
        Background="#FF9B27D4">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentPurple" Color="#8A4B6A"/>
        <SolidColorBrush x:Key="AccentDark" Color="#7A3C4E"/>
        <SolidColorBrush x:Key="MenuPink" Color="#FFD6EC"/>
        <SolidColorBrush x:Key="ListBg" Color="#F4C5C2"/>
        <SolidColorBrush x:Key="HighlightYellow" Color="#F4D766"/>

        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentPurple}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource AccentButton}">
            <Setter Property="Background" Value="{StaticResource AccentDark}"/>
        </Style>

        <Style x:Key="MenuItemText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#5C2B3A"/>
            <Setter Property="Margin" Value="8,6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,8">
            <Border Background="#8B4F63" Height="64" CornerRadius="6" VerticalAlignment="Center">
                <Grid>
                    <TextBlock Text="¿ACEPTAS EL RETO?" Foreground="White" FontSize="22" FontWeight="Bold"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Grid>
            </Border>
        </DockPanel>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Side Menu -->
            <StackPanel Grid.Column="0" Background="#FFF3DFF3">
                <TextBlock Text="MENÚ DE GESTIÓN" FontWeight="Bold" FontSize="14" 
               Margin="0,10,0,15" Foreground="#5C2B3A" HorizontalAlignment="Center"/>

                <Button Content="ALUMNADO" Style="{StaticResource AccentButton}" 
            Margin="0,4" Click="NavAlumnado_Click"/>

                <Button Content="GRUPOS" Style="{StaticResource AccentButton}" 
            Margin="0,4" Click="NavGrupos_Click"/>

                <Button Content="EMPRESAS" Style="{StaticResource AccentButton}" 
            Margin="0,4" Click="NavEmpresas_Click"/>

                <Button Content="RETOS" Style="{StaticResource AccentButton}" 
            Margin="0,4" Click="NavRetos_Click"/>

                <Button Content="TALENT LAB" Style="{StaticResource AccentButton}" 
            Margin="0,4" Click="NavTalent_Lab_Click"/>

                <Button Content="USUARIOS" Style="{StaticResource AccentButton}" 
            Margin="0,4" Click="NavUsuarios_Click"/>

                <Separator Margin="0,15" Background="#D6ACD6"/>
            </StackPanel>

            <!-- Content Area -->
            <Border Grid.Column="1" Background="#FFF7F2F2" CornerRadius="8" Padding="10">
                <TabControl x:Name="MainTabControl" TabStripPlacement="Top">

                    <!-- ALUMNADO Tab -->
                    <TabItem Header="ALUMNADO" IsSelected="True">
                        <Grid Margin="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="80"/>
                            </Grid.RowDefinitions>

                            <!-- Search Bar -->
                            <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal" Margin="6">
                                <TextBox x:Name="txtBoxBuscador" Width="280" Height="28" VerticalAlignment="Center"
                                         TextWrapping="NoWrap" Margin="0,0,8,0" 
                                         Text="Buscar alumnado"
                                         TextChanged="txtBoxBuscador_TextChanged"/>
                                <Button Content="Buscar" Width="80" Height="28" Style="{StaticResource AccentButton}"/>
                            </StackPanel>

                            <!-- DataGrid -->
                            <DataGrid x:Name="dgAlumnos"
                                      Grid.Column="0" Grid.Row="1"
                                      Margin="6"
                                      AutoGenerateColumns="False"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      SelectionChanged="dgAlumnos_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                                    <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                                    <DataGridTextColumn Header="Apellido" Binding="{Binding Apellido}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Edit Panel -->
                            <StackPanel Grid.Column="1" Grid.Row="1" Margin="18,6,6,6" VerticalAlignment="Top">
                                <TextBlock Text="ALUMNADO" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                                <TextBlock Text="Nombre" Margin="0,4,0,2" Width="213"/>
                                <TextBox x:Name="txtBoxNombreCRUD" Width="218" Height="28"/>

                                <TextBlock Text="APELLIDO" Margin="0,10,0,2" Width="217"/>
                                <TextBox x:Name="txtBoxApellidoCRUD" Width="217" Height="28"/>
                            </StackPanel>

                            <!-- Action Buttons -->
                            <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2" Orientation="Horizontal"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button x:Name="btn_AgregarDatosA" Content="Agregar" Width="120" Height="36" Click="btn_AgregarDatosA_Click" Style="{StaticResource AccentButton}"/>
                                <Button x:Name="btn_ModificarDatosA" Content="Modificar" Width="120" Height="36" Click="btn_ModificarDatosA_Click" Style="{StaticResource AccentButton}"/>
                                <Button x:Name="btn_EliminarDatosA" Content="Eliminar" Width="120" Height="36" Click="btn_EliminarDatosA_Click" Style="{StaticResource GhostButton}"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <!-- GRUPOS Tab - COMPLETO -->
                    <TabItem Header="GRUPOS">
                        <Grid Margin="8">
                            <Border BorderBrush="#B9A8C6" BorderThickness="3" CornerRadius="10" Background="White">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="36"/>
                                        <RowDefinition Height="18"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="100"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="6,0"/>

                                    <Grid Grid.Row="1" Margin="6,6,6,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="180"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="alumnado no asignado" FontWeight="Bold" FontSize="12" Foreground="#5B3A3A" Margin="0,-7,0,-3"/>
                                        <TextBlock Grid.Column="2" Text="alumnado seleccionado" FontWeight="Bold" FontSize="12" HorizontalAlignment="Left" Foreground="#5B3A3A" Margin="45,-6,0,0"/>
                                        <TextBlock Grid.Column="3" Text="NOMBRE GRUPO" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" Foreground="#5B3A3A" Margin="0,-4,0,0"/>
                                    </Grid>

                                    <Grid Grid.Row="2" Margin="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.1*"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="1.1*"/>
                                            <ColumnDefinition Width="200"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="{StaticResource ListBg}" CornerRadius="6" Padding="6" Margin="4">
                                            <ListBox x:Name="ListUnassigned" Background="Transparent" BorderThickness="0" FontSize="12" SelectionMode="Multiple"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Button x:Name="BtnMoverDerecha" Style="{StaticResource GhostButton}" Width="72" Height="30" Content="&gt;&gt;" Click="BtnMoverDerecha_Click"/>
                                            <Button x:Name="BtnMoverIzquierda" Style="{StaticResource GhostButton}" Width="72" Height="30" Content="&lt;&lt;" Margin="0,8,0,0" Click="BtnMoverIzquierda_Click"/>
                                        </StackPanel>

                                        <Border Grid.Column="2" Background="{StaticResource ListBg}" CornerRadius="6" Padding="6" Margin="4">
                                            <ListBox x:Name="ListSelected" Background="Transparent" BorderThickness="0" FontSize="12" SelectionMode="Multiple"/>
                                        </Border>

                                        <StackPanel Grid.Column="3" Margin="8" VerticalAlignment="Top">
                                            <TextBox x:Name="GroupNameTextBox" Height="26" Width="170" Background="#FFF6F6" BorderBrush="#E0D0D2" Margin="0,4,0,4" />
                                            <Button x:Name="BtnAñadirModificar" Content="Añadir/Modificar" Style="{StaticResource AccentButton}" Width="140" Click="BtnAñadirModificar_Click"/>
                                            <Button x:Name="BtnEliminar" Content="Eliminar" Style="{StaticResource AccentButton}" Background="{StaticResource AccentDark}" Width="140" Margin="0,8,0,0" Click="BtnEliminar_Click"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Grid.Row="3" Margin="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="180"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" HorizontalAlignment="Left" Height="84" VerticalAlignment="Top">
                                            <TextBlock Text="NOMBRE GRUPO (seleccionado)" FontWeight="Bold" FontSize="12" Foreground="#5B3A3A" Margin="4"/>
                                            <Border Background="{StaticResource ListBg}" CornerRadius="6" Padding="6" Margin="4" Width="320" Height="72">
                                                <ListBox x:Name="ListGroupMembers" Background="Transparent" BorderThickness="0" FontSize="12" SelectionChanged="ListGroupMembers_SelectionChanged" />
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- EMPRESAS Tab -->
                    <TabItem Header="EMPRESAS">
                        <Grid Margin="15">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBox x:Name="txtBoxBuscadorEmpresa" Width="250" Height="26" Margin="0,0,10,0" VerticalContentAlignment="Center" Text="Buscar empresa"/>
                                <Button Content="Buscar" Width="100" Height="26" Style="{StaticResource AccentButton}"/>
                            </StackPanel>

                            <DataGrid x:Name="dgEmpresas" Grid.Row="1" 
                  AutoGenerateColumns="False" 
                  Margin="0,0,0,5" MaxHeight="200"
                  SelectionChanged="dgEmpresas_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="RAZÓN SOCIAL" Binding="{Binding RazonSocial}" Width="2*"/>
                                    <DataGridTextColumn Header="CIUDAD" Binding="{Binding Ciudad}" Width="1*"/>
                                    <DataGridTextColumn Header="TELÉFONO" Binding="{Binding TelefonoContacto}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Grid.Row="2" Background="#F0F0F0" BorderBrush="{StaticResource AccentPurple}" 
                BorderThickness="3,0,0,0" Margin="0,5,0,10" Padding="15,10" CornerRadius="0,5,5,0">
                                <Grid DataContext="{Binding SelectedItem, ElementName=dgEmpresas}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="1.5*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="R. SOCIAL: " FontWeight="Bold" Foreground="{StaticResource AccentDark}" Margin="0,0,5,5"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding RazonSocial}" Margin="0,0,15,5" TextWrapping="NoWrap"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="DIR: " FontWeight="Bold" Foreground="{StaticResource AccentDark}" Margin="0,0,5,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Direccion}" Margin="0,0,15,0" TextWrapping="NoWrap" Foreground="#555"/>

                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="CIUDAD: " FontWeight="Bold" Foreground="{StaticResource AccentDark}" Margin="0,0,5,5"/>
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding Ciudad}" Margin="0,0,15,5"/>

                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="TEL: " FontWeight="Bold" Foreground="{StaticResource AccentDark}" Margin="0,0,5,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding TelefonoContacto}" Margin="0,0,15,0"/>
                                </Grid>
                            </Border>

                            <Border Grid.Row="3" Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="5" Padding="15,10">
                                <StackPanel>
                                    <TextBlock Text="GESTIÓN Y EDICIÓN DE EMPRESA" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentDark}" Margin="0,0,0,12"/>

                                    <UniformGrid Columns="3" Margin="0,0,0,10">
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="Razón Social" FontSize="11" Margin="0,0,0,3" Foreground="#666"/>
                                            <TextBox x:Name="txtBoxRazonSocialE" Height="26"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="Ciudad" FontSize="11" Margin="0,0,0,3" Foreground="#666"/>
                                            <TextBox x:Name="txtBoxCiudadE" Height="26"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Teléfono" FontSize="11" Margin="0,0,0,3" Foreground="#666"/>
                                            <TextBox x:Name="txtBoxTelefonoContactoE" Height="26"/>
                                        </StackPanel>
                                    </UniformGrid>

                                    <TextBlock Text="Dirección" FontSize="11" Margin="0,0,0,3" Foreground="#666"/>
                                    <TextBox x:Name="txtBoxDireccionE" Height="26" Margin="0,0,0,10"/>

                                    <TextBlock Text="Correo contacto" FontSize="11" Margin="0,0,0,3" Foreground="#666"/>
                                    <TextBox x:Name="txtBoxCorreoContactoE" Height="50" TextWrapping="Wrap" AcceptsReturn="True"/>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                        <Button x:Name="btn_AgregarDatosE" Content="Agregar" Width="90" Height="28" Margin="5,0" Style="{StaticResource AccentButton}" Click="btn_AgregarDatosE_Click"/>
                                        <Button x:Name="btn_ModificarDatosE" Content="Guardar" Width="90" Height="28" Margin="5,0" Style="{StaticResource AccentButton}" Click="btn_ModificarDatosE_Click"/>
                                        <Button x:Name="btn_EliminarDatosE" Content="Eliminar" Width="90" Height="28" Margin="5,0" Style="{StaticResource GhostButton}" Click="btn_EliminarDatosE_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- RETOS Tab -->
                    <TabItem Header="RETOS">
                        <Grid Margin="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="80"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal" Margin="6">
                                <TextBox x:Name="txtBoxBuscadorReto" Width="280" Height="28" VerticalAlignment="Center" Margin="0,0,8,0" Text="Buscar reto"/>
                                <Button Content="Buscar Reto" Width="100" Height="28" Click="BuscarReto_Click" Style="{StaticResource AccentButton}"/>
                            </StackPanel>

                            <DataGrid x:Name="dgRetos" Grid.Column="0" Grid.Row="1" AutoGenerateColumns="False" SelectionChanged="dgRetos_SelectionChanged" Margin="6">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                                    <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel Grid.Column="1" Grid.Row="1" Margin="18,6,6,6" VerticalAlignment="Top">
                                <TextBlock Text="GESTIÓN DE RETOS" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>

                                <TextBlock Text="ID Reto (Solo lectura)" Margin="0,4,0,2"/>
                                <TextBox x:Name="txtBoxIdReto" Width="200" Height="28" IsReadOnly="True" Background="#F0F0F0"/>

                                <TextBlock Text="Descripción" Margin="0,10,0,2"/>
                                <TextBox x:Name="txtBoxDescripcionR" Width="200" Height="80" TextWrapping="Wrap" AcceptsReturn="True"/>
                            </StackPanel>

                            <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button x:Name="btn_AgregarDatosR" Content="Agregar" Width="120" Height="36" Margin="5" Click="btn_AgregarDatosR_Click" Style="{StaticResource AccentButton}"/>
                                <Button x:Name="btn_ModificarDatosR" Content="Modificar" Width="120" Height="36" Margin="5" Click="btn_ModificarDatosR_Click" Style="{StaticResource AccentButton}"/>
                                <Button x:Name="btn_EliminarDatosR" Content="Eliminar" Width="120" Height="36" Margin="5" Click="btn_EliminarDatosR_Click" Style="{StaticResource GhostButton}"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <!-- TALENT LAB Tab -->
                    <TabItem Header="TALENT LAB">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1.2*"/>
                            </Grid.ColumnDefinitions>

                            <DataGrid x:Name="dgTalentLab" AutoGenerateColumns="False" SelectionChanged="dgTalentLab_SelectionChanged" IsReadOnly="True" Margin="5">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding IdTalentLab}" Width="30"/>
                                    <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <ScrollViewer Grid.Column="1">
                                <StackPanel Margin="10">
                                    <TextBlock Text="Reto 1" FontWeight="Bold"/>
                                    <TextBox x:Name="txtTLR1" Margin="0,0,0,10"/>

                                    <TextBlock Text="Reto 2 (Opcional)" FontWeight="Bold"/>
                                    <TextBox x:Name="txtTLR2" Margin="0,0,0,10"/>

                                    <TextBlock Text="Reto 3 (Opcional)" FontWeight="Bold"/>
                                    <TextBox x:Name="txtTLR3" Margin="0,0,0,10"/>

                                    <TextBlock Text="Grupo" FontWeight="Bold"/>
                                    <TextBox x:Name="txtTLGrupo" Margin="0,0,0,10"/>

                                    <TextBlock Text="Coste" FontWeight="Bold"/>
                                    <TextBox x:Name="txtTLCoste" Margin="0,0,0,10"/>

                                    <UniformGrid Columns="2" Margin="0,10">
                                        <Button Content="Agregar" Click="btn_AgregarTL_Click" Style="{StaticResource AccentButton}" Margin="2"/>
                                        <Button Content="Modificar" Click="btn_ModificarTL_Click" Style="{StaticResource AccentButton}" Margin="2"/>
                                        <Button Content="Eliminar" Click="btn_EliminarTL_Click" Style="{StaticResource GhostButton}" Margin="2" Grid.ColumnSpan="2"/>
                                    </UniformGrid>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <!-- USUARIOS Tab -->
                    <TabItem Header="USUARIOS">
                        <Grid Margin="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DataGrid x:Name="dgUsuarios" Margin="0,0,10,0" AutoGenerateColumns="False" SelectionChanged="dgUsuarios_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Usuario" Binding="{Binding Username}" Width="*"/>
                                    <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                                    <DataGridTextColumn Header="Correo" Binding="{Binding Correo}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Grid.Column="1" Background="#FFF7F2F2" CornerRadius="10" Padding="12" BorderBrush="#B9A8C6" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="USUARIOS" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <TextBlock Text="Username"/>
                                    <TextBox x:Name="txtUUsername" Margin="0,0,0,6"/>
                                    <TextBlock Text="Contraseña"/>
                                    <TextBox x:Name="txtUPass" Margin="0,0,0,6"/>
                                    <TextBlock Text="Nombre"/>
                                    <TextBox x:Name="txtUNombre" Margin="0,0,0,6"/>
                                    <TextBlock Text="Apellido"/>
                                    <TextBox x:Name="txtUApellido" Margin="0,0,0,6"/>
                                    <TextBlock Text="Correo"/>
                                    <TextBox x:Name="txtUCorreo" Margin="0,0,0,6"/>
                                    <TextBlock Text="Rol"/>
                                    <TextBox x:Name="txtURol" Margin="0,0,0,6"/>
                                    <TextBlock Text="Activo (1/0)"/>
                                    <TextBox x:Name="txtUActivo" Margin="0,0,0,6"/>
                                    <TextBlock Text="Id Grupo (opcional)"/>
                                    <TextBox x:Name="txtUGrupo"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                                <Button x:Name="btn_AgregarUsuario" Content="Agregar" Width="120" Height="36" Click="btn_AgregarUsuario_Click" Style="{StaticResource AccentButton}" Margin="5"/>
                                <Button x:Name="btn_ModificarUsuario" Content="Modificar" Width="120" Height="36" Click="btn_ModificarUsuario_Click" Style="{StaticResource AccentButton}" Margin="5"/>
                                <Button x:Name="btn_EliminarUsuario" Content="Eliminar" Width="120" Height="36" Click="btn_EliminarUsuario_Click" Style="{StaticResource GhostButton}" Margin="5"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                </TabControl>
            </Border>
        </Grid>
    </Grid>
</Window>