<Page x:Class="stacknavigation.view.Botones"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:stacknavigation.view"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Botones">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="5*"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Button Content="Siguiente" Grid.Row="1" HorizontalAlignment="Right" Width="100" Height="50" VerticalAlignment="Bottom" Margin="10" Click="btn_Siguiente"/>
        <Button Content="Atras" Grid.Row="1" HorizontalAlignment="Left" Width="100" Height="50" VerticalAlignment="Bottom" Margin="10" Click="btn_Atras"/>
    </Grid>
</Page>
