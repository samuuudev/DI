<Window x:Class="PruebaExamen2_Curso_JSON_DataGrid.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PruebaExamen2_Curso_JSON_DataGrid"
        xmlns:viewer="clr-namespace:SAPBusinessObjects.WPF.Viewer;assembly=SAPBusinessObjects.WPF.Viewer"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <TabControl>
            <TabItem Header="Cursos">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>

                    <DataGrid x:Name="dgCursos" AutoGenerateColumns="False" CanUserAddRows="False" Margin="10" SelectionChanged="dgCursos_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="40"/>
                            <DataGridTextColumn Header="Nombre Curso" Binding="{Binding Nombre}" Width="*"/>
                            <DataGridTextColumn Header="Creditos" Binding="{Binding Creditos}" Width="*"/>
                            <DataGridTextColumn Header="Nombre Profesor" Binding="{Binding NombreProfesorJSON}" Width="*"/>
                            <DataGridTextColumn Header="Especialidad" Binding="{Binding Especialidad}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Column="1" Margin="15" Background="#F9F9F9">
                        <TextBlock Text="Datos del Curso" FontWeight="Bold" FontSize="16" Margin="0,10,0,20" HorizontalAlignment="Center"/>

                        <Label Content="Nombre Curso:" Padding="5,0,0,2" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtCursoNombre" Margin="5,0,5,15" Padding="5"/>

                        <Label Content="Creditos:" Padding="5,0,0,2" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtCursoCredito" Margin="5,0,5,15" Padding="5"/>

                        <Label Content="Especialidad:" Padding="5,0,0,2" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtEspecialidad" Margin="5,0,5,25" Padding="5"/>

                        <Separator Margin="5,0,5,15" Background="#E0E0E0"/>

                        <Button x:Name="btnCursoAdd" Content="Añadir Curso" Click="btnCursoAdd_Click" Margin="5,4" Padding="10,6" Background="LightGreen" FontWeight="SemiBold"/>
                        <Button x:Name="btnCursoMod" Content="Modificar Cliente" Click="btnCursoMod_Click" Margin="5,4" Padding="10,6" Background="LightBlue" FontWeight="SemiBold"/>
                        <Button x:Name="btnCursoDel" Content="Eliminar Cliente" Click="btnCursoDel_Click"  Margin="5,4" Padding="10,6" Background="LightCoral" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Informe">
                <Grid>
                    <viewer:CrystalReportsViewer x:Name="visor" HorizontalAlignment="Center" Margin="0,10,0,0" VerticalAlignment="Top" Width="774" Height="307"/>
                    <Button x:Name="btnVerCurso" 
                        Content="Ver Curso" 
                        Click="btnInformeCurso_Click" 
                        Width="150" Height="40" 
                        HorizontalAlignment="Center" VerticalAlignment="Top" 
                        Margin="0,337,0,0"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
