        private void CargarInforme(int? mes = null, int? anio = null)
        {
            try
            {
                string query = "SELECT r.idreserva, r.idhuesped, r.idparcela, r.fechaentrada, r.fechasalida, r.costetotal, r.estado FROM mancha.reserva r";

                if (mes.HasValue && anio.HasValue)
                {
                    DateTime inicioMes = new DateTime(anio.Value, mes.Value, 1);
                    DateTime inicioMesSiguiente = inicioMes.AddMonths(1);

                    query += " WHERE r.fechaentrada >= '" + inicioMes.ToString("yyyy-MM-dd") +
                             "' AND r.fechaentrada < '" + inicioMesSiguiente.ToString("yyyy-MM-dd") + "'";
                }

                query += ";";

                List<object> resultado = DBBroker.obtenerAgente().leer(query);

                DataTable tabla1 = new DataTable("Reservas");
                tabla1.Columns.Add("idreserva", typeof(string));
                tabla1.Columns.Add("idhuesped", typeof(string));
                tabla1.Columns.Add("idparcela", typeof(string));
                tabla1.Columns.Add("fechaentrada", typeof(string));
                tabla1.Columns.Add("fechasalida", typeof(string));
                tabla1.Columns.Add("costetotal", typeof(string));
                tabla1.Columns.Add("estado", typeof(string));

                foreach (List<object> fila in resultado)
                {
                    DateTime fechaEntrada;
                    DateTime fechaSalida;
                    double costeTotal;

                    DateTime.TryParse(fila[3].ToString(), out fechaEntrada);
                    DateTime.TryParse(fila[4].ToString(), out fechaSalida);

                    if (!double.TryParse(fila[5].ToString(), NumberStyles.Any, CultureInfo.CurrentCulture, out costeTotal) &&
                        !double.TryParse(fila[5].ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out costeTotal))
                    {
                        costeTotal = 0;
                    }

                    tabla1.Rows.Add(
                        fila[0].ToString(),
                        fila[1].ToString(),
                        fila[2].ToString(),
                        fechaEntrada == DateTime.MinValue ? string.Empty : fechaEntrada.ToString("dd/MM/yyyy"),
                        fechaSalida == DateTime.MinValue ? string.Empty : fechaSalida.ToString("dd/MM/yyyy"),
                        costeTotal.ToString("N2", CultureInfo.CurrentCulture) + " €",
                        fila[6].ToString().ToUpper());
                }

                CrystalReport1 report = new CrystalReport1();
                report.Database.Tables["Reservas"].SetDataSource(tabla1);
                reportViewer.ViewerCore.ReportSource = report;
            }
            catch (Exception ex)
            {
                MessageBox.Show("Error al generar el informe: " + ex.Message);
            }
        }

        private void btnGenerarInforme_Click(object sender, RoutedEventArgs e)
        {
            if (cmbMesInforme.SelectedItem == null || cmbAnioInforme.SelectedItem == null)
            {
                CargarInforme();
                return;
            }

            int mes = Convert.ToInt32(cmbMesInforme.SelectedItem);
            int anio = Convert.ToInt32(cmbAnioInforme.SelectedItem);

            CargarDataTableReservasMes(mes, anio);
            CargarDataTableFinancieroMes(mes, anio);
            CargarInforme(mes, anio);
        }

