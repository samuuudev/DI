        private void CargarDataTableReservasMes(int mes, int anio)
        {
            DataTable tablaReservasMes = dataSetInformes.Tables["ReservasMes"];
            if (tablaReservasMes == null) { return; }

            tablaReservasMes.Clear();

            DateTime inicioMes = new DateTime(anio, mes, 1);
            DateTime inicioMesSiguiente = inicioMes.AddMonths(1);

            string sql = "SELECT r.idreserva, r.fechaentrada, r.fechasalida, h.nombre, tv.tipovehiculo, h.matricula, r.idparcela, r.costetotal, r.estado " +
                         "FROM mancha.reserva r " +
                         "INNER JOIN mancha.huesped h ON h.idhuesped = r.idhuesped " +
                         "INNER JOIN mancha.tipovehiculo tv ON tv.idtipovehiculo = h.idtipovehiculo " +
                         "WHERE r.fechaentrada >= '" + inicioMes.ToString("yyyy-MM-dd") + "' " +
                         "AND r.fechaentrada < '" + inicioMesSiguiente.ToString("yyyy-MM-dd") + "' " +
                         "ORDER BY r.fechaentrada;";

            List<object> resultado = DBBroker.obtenerAgente().leer(sql);
            foreach (List<object> fila in resultado)
            {
                tablaReservasMes.Rows.Add(
                    fila[0].ToString(),
                    Convert.ToDateTime(fila[1]).ToString("dd/MM/yyyy"),
                    Convert.ToDateTime(fila[2]).ToString("dd/MM/yyyy"),
                    fila[3].ToString(),
                    fila[4].ToString(),
                    fila[5].ToString(),
                    fila[6].ToString(),
                    Convert.ToDouble(fila[7], CultureInfo.InvariantCulture).ToString("N2", CultureInfo.CurrentCulture),
                    fila[8].ToString());
            }
        }

        private void CargarDataTableFinancieroMes(int mes, int anio)
        {
            DataTable tablaFinancieroMes = dataSetInformes.Tables["FinancieroMes"];
            if (tablaFinancieroMes == null) { return; }

            tablaFinancieroMes.Clear();

            DateTime inicioMes = new DateTime(anio, mes, 1);
            DateTime inicioMesSiguiente = inicioMes.AddMonths(1);

            string sql = "SELECT YEAR(r.fechaentrada) AS anio, MONTH(r.fechaentrada) AS mes, COALESCE(SUM(r.costetotal),0) AS ingresostotales " +
                         "FROM mancha.reserva r " +
                         "WHERE r.fechaentrada >= '" + inicioMes.ToString("yyyy-MM-dd") + "' " +
                         "AND r.fechaentrada < '" + inicioMesSiguiente.ToString("yyyy-MM-dd") + "' " +
                         "GROUP BY YEAR(r.fechaentrada), MONTH(r.fechaentrada);";

            List<object> resultado = DBBroker.obtenerAgente().leer(sql);

            if (resultado.Count == 0)
            {
                tablaFinancieroMes.Rows.Add(
                    anio.ToString(),
                    mes.ToString(),
                    0d.ToString("N2", CultureInfo.CurrentCulture));
                return;
            }

            foreach (List<object> fila in resultado)
            {
                tablaFinancieroMes.Rows.Add(
                    fila[0].ToString(),
                    fila[1].ToString(),
                    Convert.ToDouble(fila[2], CultureInfo.InvariantCulture).ToString("N2", CultureInfo.CurrentCulture));
            }
        }

