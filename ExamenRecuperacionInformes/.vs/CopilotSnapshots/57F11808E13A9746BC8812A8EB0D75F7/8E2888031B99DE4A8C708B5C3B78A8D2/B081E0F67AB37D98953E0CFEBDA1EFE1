        private void CargarInforme(int? mes = null, int? anio = null)
        {
            try
            {
                string query = "SELECT r.idreserva, r.idhuesped, r.idparcela, r.fechaentrada, r.fechasalida, r.costetotal, r.estado " +
                               "FROM mancha.reserva r";

                if (mes.HasValue && anio.HasValue)
                {
                    DateTime inicioMes = new DateTime(anio.Value, mes.Value, 1);
                    DateTime inicioMesSiguiente = inicioMes.AddMonths(1);

                    query += " WHERE r.fechaentrada >= '" + inicioMes.ToString("yyyy-MM-dd") +
                             "' AND r.fechaentrada < '" + inicioMesSiguiente.ToString("yyyy-MM-dd") + "'";
                }

                query += ";";


                List<Object> resultado = DBBroker.obtenerAgente().leer(query);


                DataTable tabla1 = new DataTable("Reservas");
                tabla1.Columns.Add("idreserva");
                tabla1.Columns.Add("idhuesped");
                tabla1.Columns.Add("idparcela");
                tabla1.Columns.Add("fechaentrada");
                tabla1.Columns.Add("fechasalida");
                tabla1.Columns.Add("costetotal");
                tabla1.Columns.Add("estado");


                foreach (List<Object> fila in resultado)
                {

                    tabla1.Rows.Add(fila.ToArray());
                }


                CrystalReport1 report = new CrystalReport1();
                report.Database.Tables["Reservas"].SetDataSource(tabla1);
                reportViewer.ViewerCore.ReportSource = report;
            }
            catch (Exception ex)
            {
                MessageBox.Show("Error al generar el informe: " + ex.Message);
            }
        }

        private void btnGenerarInforme_Click(object sender, RoutedEventArgs e)
        {
            if (cmbMesInforme.SelectedItem == null || cmbAnioInforme.SelectedItem == null)
            {
                CargarInforme();
                return;
            }

            int mes = Convert.ToInt32(cmbMesInforme.SelectedItem);
            int anio = Convert.ToInt32(cmbAnioInforme.SelectedItem);
            CargarInforme(mes, anio);
        }

