            if (!double.TryParse(txtBoxCosteTotalReserva.Text, NumberStyles.Any, CultureInfo.CurrentCulture, out costeTotal) &&
                !double.TryParse(txtBoxCosteTotalReserva.Text, NumberStyles.Any, CultureInfo.InvariantCulture, out costeTotal))
