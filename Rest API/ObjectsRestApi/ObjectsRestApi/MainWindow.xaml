<Window x:Class="ObjectRestApi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="API Request WPF" Height="423" Width="543">
    <Grid>
        <Button Content="Cargar Datos" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,20,0,0" Width="100" Click="LoadDataButton_Click"/>
        <Button Content="Añadir Objeto" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="140,20,0,0" Width="120" Click="AddObjectButton_Click"/>
        <Button Content="Borrar Objeto" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="282,21,0,0" Width="120" Click="DeleteObjectByPostButton_Click"/>
        <ListBox x:Name="ResultsListBox" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,60,0,0" Height="250" Width="480"/>
        <TextBox x:Name="PostResultTextBox" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,320,0,0" Height="77" Width="480" IsReadOnly="True" Text="Resultado POST aquí"/>
    </Grid>
</Window>