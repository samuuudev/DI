<Window x:Class="Ejercicio2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="8*"/>
        </Grid.RowDefinitions>
        
        <TabControl Grid.Row="1">
            <TabItem Header="Inicializacion">
                <Grid Background="#FFE5E5E5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="4*"/>
                    </Grid.RowDefinitions>
                    <StackPanel x:Name="stckPanelParametrosTabla" Margin="0,0,0,59">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Label Name="lbNumParedes" Content="Número de paredes" Grid.Row="0" Grid.Column="0"/>
                            <TextBox Name="txtbNumParedes" Grid.Row="1" Grid.Column="0"/>

                            <Button Name="btnSumarParedes" Content="+" Grid.Row="0" Grid.Column="1"/>
                            <Button Name="btnRestarParedes" Content="-" Grid.Row="1" Grid.Column="1"/>

                            <Label Name="lbNumRatones" Content="Número de ratones" Grid.Row="0" Grid.Column="2"/>
                            <TextBox Name="txtbNumRatones" Grid.Row="1" Grid.Column="2"/>

                            <Button Name="btnSumarRatones" Content="+" Grid.Row="0" Grid.Column="3"/>
                            <Button Name="btnRestarRatones" Content="-" Grid.Row="1" Grid.Column="3"/>
                        </Grid>
                    </StackPanel>

                    <!-- Nick del jugador y botón de iniciar juego -->
                    <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="100,0,0,0" HorizontalAlignment="Center">
                        <Label x:Name="lbNickJugador" Content="NICKJUGADOR" Width="100" Height="30" />
                        <TextBox x:Name="txtboxNickJugador" Width="200" Height="30" />
                        <Button x:Name="btnIniciarJuego" Content="Iniciar Juego" Width="100" HorizontalAlignment="Right" Margin="100,0,0,0" Height="30" Click="btnIniciarJuego_Click"/>
                    </StackPanel>
                    
                    <!-- Tabla del tablero -->
                    <Grid Name="contenedorTablero" Grid.Row="2" ShowGridLines="True" Margin="0,59,0,0">
                    </Grid>

                    <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Button Name="btnArriba" Content="⬆️" Width="40" Height="40"/>
                        <Button Name="btnAbajo" Content="⬇️" Width="40" Height="40"/>
                        <StackPanel Orientation="Vertical">
                            <Button Name="btnIzquierda" Content="⬅️" Width="40" Height="40"/>
                            <Button Name="btnDerecha" Content="➡️" Width="40" Height="40"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Ranking">
                <Grid Name="gdContenedorJug" Background="#FFE5E5E5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="4*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBox x:Name="txtBoxBuscador" HorizontalAlignment="Center" TextWrapping="Wrap" Text="Search" VerticalAlignment="Center" Width="300" Height="35"/>

                    <DataGrid x:Name="dgJugador" Grid.Row="1" Margin="10,10,10,10"/>

                    <Label x:Name="lbJugadorCRUD" Content="JUGADOR" Grid.Row="1" Grid.Column="1" Width="200"/>
                    <StackPanel x:Name="stpJugadorCRUD" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Label x:Name="lbNombreCRUD" Content="NICKNAME: " />
                        <TextBox x:Name="txtBoxNombreCRUD" Width="200" Height="25" />
                        
                        <Label x:Name="lbPuntuacionCRUD" Content="PUNTUACION: " />
                        <TextBox x:Name="txtBoxPuntuacionCRUD" Height="25"/>
                        
                        <Label x:Name="lbFechaCRUD" Content="Fecha"/>
                        <DatePicker x:Name="datePickerFechaCRUD" Width="200" Height="25"/>
                        
                        <Label x:Name="lbCursoCRUD" Content="NIVEL: " />
                        <ComboBox x:Name="cmbBoxCursoCRUD" Width="200" Height="25">
                            <ComboBoxItem Content="0" />
                            <ComboBoxItem Content="1" />
                            <ComboBoxItem Content="2" />
                            <ComboBoxItem Content="3" />
                            <ComboBoxItem Content="4" />
                            <ComboBoxItem Content="5" />
                            <ComboBoxItem Content="6" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Grid.Column="0" Margin="10" Content="Agregar" Name="btn_AgregarDatos" Click="btn_AgregarDatos_Click" Width="100" Height="30"/>
                        <Button Grid.Column="1" Margin="10" Content="Modificar" Name="btn_ModificarDatos" Click="btn_ModificarDatos_Click" Width="100" Height="30"/>
                        <Button Grid.Column="2" Margin="10" Content="Eliminar" Name="btn_EliminarDatos" Click="btn_EliminarDatos_Click" Width="100" Height="30" BorderBrush="#FF707070"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
